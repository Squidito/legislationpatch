{
  "name": "legislationpatch",
  "version": "1.0.0",
  "description": "U.S. federal legislation explained in plain English — patch notes style.",
  "main": "api.js",
  "scripts": {
    "add-bills": "node scripts/add-bills.js",
    "smoke": "node scripts/smoke-test.js",
    "batch": "node scripts/run-batch.js",
    "batch:post": "node scripts/run-batch.js --post",
    "batch:fetch": "node scripts/run-batch.js --fetch-only",
    "validate": "node scripts/validate-batch.js",
    "attribution": "node scripts/validate-batch.js --attribution",
    "normalize": "node scripts/normalize-analysis.js --all",
    "quarantine": "node scripts/quarantine.js",
    "quarantine:list": "node scripts/quarantine.js --list",
    "quarantine:restore": "node scripts/quarantine.js --restore",
    "qa-verify": "node scripts/qa-source-verify.js",
    "parity": "node scripts/check-parity.js",
    "sitemap": "node scripts/generate_sitemap.js",
    "search-index": "node scripts/generate-search-index.js",
    "digest": "node scripts/generate_digest.js",
    "feed": "node scripts/generate_feed.js",
    "stale": "node scripts/article-staleness.js",
    "backlog": "node scripts/article-backlog.js",
    "goldset:select": "node scripts/goldset-select.js",
    "goldset:score": "node scripts/goldset-score.js",
    "qa-ledger": "node scripts/qa-ledger-report.js",
    "qa-ledger:seed": "node scripts/qa-ledger-seed.js",
    "qa-receipts": "node scripts/qa-receipts.js",
    "qa-provenance": "node scripts/qa-provenance-stamp.js",
    "qa-regression": "node scripts/qa-ledger-regression.js",
    "qa-inject": "node scripts/qa-injection-generate.js",
    "qa-inject:score": "node scripts/qa-injection-score.js",
    "qa-metrics": "node scripts/qa-metrics-snapshot.js",
    "qa-metrics:render": "node scripts/qa-metrics-render.js",
    "pages": "node scripts/generate_bill_pages.js",
    "og": "node scripts/generate_brand_assets.js --bills",
    "reps": "node scripts/generate_reps.js",
    "test": "node scripts/security-check.js && node scripts/test-security-helpers.js && node scripts/normalize-analysis.js --self-test && node scripts/validate-batch.js",
    "facts": "node scripts/bill-facts.js",
    "refresh": "node scripts/refresh_stages.js",
    "flag-drift": "node scripts/flag-version-drift.js",
    "security": "node scripts/security-check.js",
    "test:security": "node scripts/test-security-helpers.js",
    "prepare": "git config core.hooksPath scripts/hooks",
    "author": "node scripts/generate_author_page.js",
    "author:check": "node scripts/generate_author_page.js --check",
    "news-sitemap": "node scripts/generate_news_sitemap.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "entities": "node scripts/migrate-article-entities.js",
    "doc-provenance": "node scripts/doc-provenance.js",
    "doc-provenance:stamp": "node scripts/doc-provenance.js --stamp",
    "preflight": "node scripts/preflight.js",
    "articles:index": "node scripts/generate_articles_index.js",
    "articles:index:check": "node scripts/generate_articles_index.js --check",
    "articles:extract": "node scripts/extract-articles-index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Squidito/legislationpatch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Squidito/legislationpatch/issues"
  },
  "homepage": "https://github.com/Squidito/legislationpatch#readme",
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
